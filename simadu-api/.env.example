# Salin file ini menjadi .env lalu ganti nilainya.
PORT=3000

# Kunci penandatangan token (WAJIB, minimal 16 karakter).
# Buat acak, contoh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Masa berlaku token (contoh: 15m, 1h)
JWT_EXPIRES_IN=15m

# Biaya hashing bcrypt (10-12 untuk pengembangan)
BCRYPT_ROUNDS=10
